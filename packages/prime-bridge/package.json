{
  "type": "module",
  "name": "@oh-my-pi/prime-bridge",
  "version": "18.0.2",
  "description": "Durable local Prime Agent bridge runtime",
  "homepage": "https://omp.sh",
  "author": "Stencil Labs, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/prime-bridge"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@oh-my-pi/prime-bridge-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "test",
    "prime-skill"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "bin": {
    "omp-prime-bridge": "./src/cli.ts"
  }
}
