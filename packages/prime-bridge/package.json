{
  "type": "module",
  "name": "@oh-my-pi/prime-bridge",
  "version": "17.2.13",
  "description": "Durable local Prime Agent bridge runtime",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/prime-bridge"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel",
    "test:session-resume:native": "bun -e 'if (!process.env.PRIME_AGENT_BIN) throw new Error(\"PRIME_AGENT_BIN is required for the native Prime continuation gate\")' && bun test test/integration/session-resume.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@oh-my-pi/omptype": "catalog:",
    "@oh-my-pi/pi-ai": "workspace:*",
    "@oh-my-pi/pi-coding-agent": "workspace:*",
    "@oh-my-pi/pi-utils": "workspace:*",
    "@oh-my-pi/prime-bridge-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "prime-skill",
    "prime-skill-tools",
    "test"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "bin": {
    "omp-prime-bridge": "./src/cli.ts"
  }
}
