{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@oh-my-pi/prime-bridge-protocol": ["../prime-bridge-protocol/dist/types/index.d.ts"]
		},
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"inlineSources": false,
		"rootDir": "src",
		"outDir": "dist/types",
		"noCheck": true
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules", "test"]
}
